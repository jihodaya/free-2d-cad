+		/// </summary>
+		internal static string EscapeUnencodable(string value, Encoding encoding)
+		{
+			int i = 0;
+			while (i < value.Length && value[i] < 0x80)
+			{
+				i++;
+			}
+			if (i == value.Length || encoding.CodePage == Encoding.Unicode.CodePage || encoding.CodePage == Encoding.UTF8.CodePage)
+			{
+				return value;
+			}
+			var sb = new StringBuilder(value.Length + 8);
+			sb.Append(value, 0, i);
+			for (; i < value.Length; i++)
+			{
+				char ch = value[i];
+				if (ch < 0x80)
+				{
+					sb.Append(ch);
+					continue;
+				}
+				string one = char.IsHighSurrogate(ch) && i + 1 < value.Length ? value.Substring(i, 2) : ch.ToString();
+				if (encoding.GetString(encoding.GetBytes(one)) == one)
+				{
+					sb.Append(one);
+				}
+				else
+				{
+					foreach (char c in one)
+					{
+						sb.Append("\\U+").Append(((int)c).ToString("X4"));
+					}
+				}
+				i += one.Length - 1;
+			}
+			return sb.ToString();
+		}
